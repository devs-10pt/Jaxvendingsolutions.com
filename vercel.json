{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd webapp && bun run build",
  "outputDirectory": "webapp/dist",
  "installCommand": "cd webapp && bun install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://preview-hkgpvvhlvkfd.dev.vibecode.run/api/:path*"
    }
  ]
}
